{
  "expo": {
    "name": "VibeMsg",
    "slug": "mobile",
    "version": "1.0.0",
    "buildNumber": "1",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vibemsg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0A0E1A",
    "primaryColor": "#7B5EA7",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vibemsg.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "VibeMsg uses your camera to take secure pictures to send in chats.",
        "NSPhotoLibraryUsageDescription": "VibeMsg accesses your photo library to share images in messages.",
        "NSPhotoLibraryAddUsageDescription": "VibeMsg saves received photos to your library.",
        "NSMicrophoneUsageDescription": "VibeMsg uses your microphone for voice messages and voice/video calls.",
        "NSContactsUsageDescription": "VibeMsg uses your contacts to find friends who are already on the app and to invite others.",
        "NSFaceIDUsageDescription": "VibeMsg uses Face ID to unlock passcode-protected chats.",
        "UIBackgroundModes": ["audio", "fetch", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vibemsg.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "VibeMsg needs access to your contacts to find who's on the app and invite others."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VibeMsg uses your camera to take secure pictures to send in chats.",
          "microphonePermission": "VibeMsg uses your microphone for voice messages and calls."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7B5EA7",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VibeMsg accesses your photos to share images in messages.",
          "cameraPermission": "VibeMsg uses your camera to capture images for messages."
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/YOUR_EAS_PROJECT_ID"
    }
  }
}
